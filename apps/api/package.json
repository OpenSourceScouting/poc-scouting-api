{
  "name": "@scouting/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "tsx scripts/generate-seed.ts && wrangler d1 execute DB --local --file seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed:local",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "dev:setup": "tsx scripts/dev-setup.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "predev": "tsx scripts/vendor-docs.ts",
    "prebuild": "tsx scripts/vendor-docs.ts",
    "pretest": "tsx scripts/vendor-docs.ts",
    "predeploy:staging": "tsx scripts/vendor-docs.ts",
    "predeploy:production": "tsx scripts/vendor-docs.ts",
    "db:verify-seed": "tsx scripts/verify-seed.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "swagger-ui-dist": "5.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "vitest": "~5.0",
    "wrangler": "^4.155.0"
  }
}
