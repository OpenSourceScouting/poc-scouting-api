{
  "name": "@scouting/api-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Scouting API, generated from the OpenAPI contract.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "vitest": "~5.0"
  }
}
